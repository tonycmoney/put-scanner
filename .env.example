# Copy to backend/.env for local runs. Never commit real values.
DATABASE_URL=sqlite:///./scanner.db

# Webull OpenAPI app credentials (Webull app > API Management).
# The scanner stays idle until both are set.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ENV=sandbox          # sandbox (paper) or production

# Optional Discord or Slack incoming webhook for new pick alerts
ALERT_WEBHOOK_URL=

SCHEDULER_ENABLED=true
SCAN_TIMES=10:00,11:00,12:00,13:00,14:00,15:00,15:55
GRADE_TIME=16:15
BUDGET=5000
MAX_LOSS_PCT=0.05
